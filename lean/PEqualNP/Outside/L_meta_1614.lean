open PEqualNP.CircuitLowerBounds

def sound (N : ℕ) (I : Fin N → Fin N → Prop) (Ckt : Circuit) (w : ℕ) (ut : Fin N) : Prop :=
  ∀ za : Fin (N + N) → Bool, (∀ pa : Fin N, I pa ut → za (Fin.castAdd N pa) = false) →
    (Ckt.wires (List.ofFn za)).getD w false = true →
    ∃ (qa ma : Fin N), I qa ma ∧ za (Fin.castAdd N qa) = true ∧ za (Fin.natAdd N ma) = true

noncomputable def wl (N : ℕ) (I : Fin N → Fin N → Prop) (Ckt : Circuit) (w : ℕ) :
    Finset (Fin N) := by
  classical
  exact Finset.univ.filter (fun u => sound N I Ckt w u)

lemma mem_wl (N : ℕ) (I : Fin N → Fin N → Prop) (Ckt : Circuit) (w : ℕ) (u : Fin N) :
    u ∈ wl N I Ckt w ↔ sound N I Ckt w u := by
  classical
  unfold wl
  simp

