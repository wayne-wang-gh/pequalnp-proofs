    (by
      intro jd
      induction jd using Fin.addCases with
      | left j => rw [Fin.append_left]; exact (hdeg j).1
      | right j => rw [Fin.append_right]; exact (hdeg j).2)
    (by
      intro jb zz hz hw
      obtain ⟨uz, huz, hzz⟩ := hz
      induction jb using Fin.addCases with
      | left j =>
        rw [Fin.append_left] at huz hw
        exact (mem_wl N I Ckt (fa j) uz).mp huz zz hzz hw
      | right j =>
        rw [Fin.append_right] at huz hw
        exact (mem_wl N I Ckt (fb j) uz).mp huz zz hzz hw)
  refine le_trans (Finset.card_le_card ?_) key
  intro e he
  simp only [Finset.mem_filter, Finset.mem_univ, true_and] at he ⊢
  obtain ⟨hI, _, ⟨jc, hfa, hfb⟩, hall⟩ := he
  obtain ⟨_, _, jt, hta, htb, ut, hut, hs⟩ := hall jc hfa hfb
  refine ⟨hI, ?_⟩
  rcases hs with hs | hs
  · refine ⟨Fin.castAdd Jn jt, ⟨ut, ?_, hut⟩, ?_⟩
    · rw [Fin.append_left]; exact (mem_wl N I Ckt (fa jt) ut).mpr hs
    · rw [Fin.append_left]; exact hta
  · refine ⟨Fin.natAdd Jn jt, ⟨ut, ?_, hut⟩, ?_⟩
    · rw [Fin.append_right]; exact (mem_wl N I Ckt (fb jt) ut).mpr hs
    · rw [Fin.append_right]; exact htb

