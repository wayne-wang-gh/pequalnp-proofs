def blockOk (a : ℕ) : Bool := rd (run gatesL 146 (initS a)) 856 == expB incL a

theorem ok_0 : ∀ d < 21, blockOk (21 * 0 + d) = true := by decide +kernel

theorem ok_1 : ∀ d < 21, blockOk (21 * 1 + d) = true := by decide +kernel

theorem ok_2 : ∀ d < 21, blockOk (21 * 2 + d) = true := by decide +kernel

theorem ok_3 : ∀ d < 21, blockOk (21 * 3 + d) = true := by decide +kernel

theorem ok_4 : ∀ d < 21, blockOk (21 * 4 + d) = true := by decide +kernel

theorem ok_5 : ∀ d < 21, blockOk (21 * 5 + d) = true := by decide +kernel

theorem ok_6 : ∀ d < 21, blockOk (21 * 6 + d) = true := by decide +kernel

theorem allOk (a : ℕ) (ha : a < 147) : blockOk a = true := by
  obtain ⟨q, r, hq, hr, rfl⟩ : ∃ q r, q < 7 ∧ r < 21 ∧ a = 21 * q + r :=
    ⟨a / 21, a % 21, by omega, by omega, by omega⟩
  interval_cases q
  · exact ok_0 r hr
  · exact ok_1 r hr
  · exact ok_2 r hr
  · exact ok_3 r hr
  · exact ok_4 r hr
  · exact ok_5 r hr
  · exact ok_6 r hr

theorem hAO : ∀ g ∈ gatesL, isAO g.op = true := by
  have h : gatesL.all (fun g => isAO g.op) = true := by decide +kernel
  exact fun g hg => List.all_eq_true.mp h g hg

theorem incBound : ∀ pl ∈ incL, pl.1 < 73 ∧ pl.2 < 73 := by decide +kernel

theorem main3 (x y : Fin 73 → Bool)
    (h : (Finset.univ.filter (fun p : Fin 73 => x p = true)).card
      + (Finset.univ.filter (fun l : Fin 73 => y l = true)).card ≤ 2) :
    Circuit.eval ⟨gatesL, 856⟩ (List.ofFn x ++ List.ofFn y)
      = decide (∃ p : Fin 73, ∃ l : Fin 73,
          ((p : ℕ), (l : ℕ)) ∈ incL ∧ x p = true ∧ y l = true) := by
  obtain ⟨a, b, ha, hb, hx, hy⟩ := two_rows x y h
  have hS : ∀ i, (initS a).testBit (147 * i + b)
      = (List.ofFn x ++ List.ofFn y).getD i false := by
    intro i
    rw [init_bit a b i hb, z_getD x y a b hx hy i]
  have hlen : (List.ofFn x ++ List.ofFn y).length = 146 := by simp
  have e := run_bit b hb 856 gatesL hAO (initS a) _ hS 856
  rw [hlen] at e
  have hok := allOk a ha
  unfold blockOk at hok
  rw [beq_iff_eq] at hok
  have e2 : Circuit.eval ⟨gatesL, 856⟩ (List.ofFn x ++ List.ofFn y)
      = (expB incL a).testBit b := by
    rw [← hok, rd_bit _ _ _ hb, e]
    rfl
  rw [e2, Bool.eq_iff_iff, expB_bit, decide_eq_true_eq]
  constructor
  · rintro ⟨pl, hpl, hc⟩
