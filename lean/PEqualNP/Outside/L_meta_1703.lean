import Mathlib
import PEqualNP.Defs

namespace PEqualNP.Outside.L_meta_1703

open PEqualNP.CircuitLowerBounds

def isAO : GateOp → Bool
  | GateOp.and => true
  | GateOp.or => true
  | _ => false

def bop (M : ℕ) : GateOp → List ℕ → ℕ
  | GateOp.and, l => l.foldr Nat.land M
  | GateOp.or, l => l.foldr Nat.lor 0
  | _, _ => 0

theorem bop_bit (M j : ℕ) (hM : M.testBit j = true) (op : GateOp) (h : isAO op = true)
    (l : List ℕ) : (bop M op l).testBit j = op.eval (l.map fun n => n.testBit j) := by
  cases op with
  | and =>
    induction l with
    | nil => simp [bop, GateOp.eval, hM]
    | cons a t ih =>
      simp only [bop, GateOp.eval, List.foldr_cons, List.map_cons, List.all_cons, id] at ih ⊢
      rw [← ih]
      exact Nat.testBit_land a _ j
  | or =>
    induction l with
    | nil => simp [bop, GateOp.eval]
    | cons a t ih =>
      simp only [bop, GateOp.eval, List.foldr_cons, List.map_cons, List.any_cons, id] at ih ⊢
      rw [← ih]
      exact Nat.testBit_lor a _ j
  | not => simp [isAO] at h
  | mod m => simp [isAO] at h
  | maj => simp [isAO] at h

def MB : ℕ := 2 ^ 147 - 1

theorem MB_bit (b : ℕ) : MB.testBit b = decide (b < 147) := by
  unfold MB
  exact Nat.testBit_two_pow_sub_one 147 b

def rd (S i : ℕ) : ℕ := (S >>> (147 * i)) &&& MB

theorem rd_bit (S i b : ℕ) (hb : b < 147) : (rd S i).testBit b = S.testBit (147 * i + b) := by
  unfold rd
  rw [Nat.testBit_land, Nat.testBit_shiftRight, MB_bit, decide_eq_true hb, Bool.and_true]

def stp (S n : ℕ) (g : Gate) : ℕ :=
  S ||| ((bop MB g.op (g.inputs.map (rd S)) &&& MB) <<< (147 * n))

def run : List Gate → ℕ → ℕ → ℕ
  | [], _, S => S
  | g :: t, n, S => run t (n + 1) (stp S n g)

theorem stp_bit (b : ℕ) (hb : b < 147) (g : Gate) (hg : isAO g.op = true) (S : ℕ)
    (wl : List Bool) (hS : ∀ i, S.testBit (147 * i + b) = wl.getD i false) (i : ℕ) :
    (stp S wl.length g).testBit (147 * i + b)
      = (wl ++ [g.op.eval (g.inputs.map fun k => wl.getD k false)]).getD i false := by
  have hv : (bop MB g.op (g.inputs.map (rd S))).testBit b
      = g.op.eval (g.inputs.map fun k => wl.getD k false) := by
    rw [bop_bit MB b (by rw [MB_bit]; exact decide_eq_true hb) g.op hg, List.map_map]
    congr 1
    apply List.map_congr_left
    intro k _
    simp only [Function.comp]
    rw [rd_bit S k b hb, hS k]
  unfold stp
  rw [Nat.testBit_lor, Nat.testBit_shiftLeft, Nat.testBit_land, MB_bit, hS i]
  rcases Nat.lt_trichotomy i wl.length with h | h | h
  · have h1 : ¬ (147 * i + b ≥ 147 * wl.length) := by omega
    rw [decide_eq_false h1, Bool.false_and, Bool.or_false]
    simp [List.getD_eq_getElem?_getD, List.getElem?_append_left h]
  · subst h
    have h1 : 147 * wl.length + b ≥ 147 * wl.length := by omega
    have h2 : 147 * wl.length + b - 147 * wl.length = b := by omega
    rw [decide_eq_true h1, h2, hv, decide_eq_true hb, Bool.and_true, Bool.true_and]
    simp [List.getD_eq_getElem?_getD]
  · have h3 : ¬ (147 * i + b - 147 * wl.length < 147) := by omega
    rw [decide_eq_false h3, Bool.and_false, Bool.and_false, Bool.or_false]
    have h4 : wl.length ≤ i := by omega
    have h5 : (wl ++ [g.op.eval (g.inputs.map fun k => wl.getD k false)]).length ≤ i := by
      rw [List.length_append, List.length_singleton]; omega
    rw [List.getD_eq_getElem?_getD, List.getD_eq_getElem?_getD,
      List.getElem?_eq_none h4, List.getElem?_eq_none h5]

theorem run_bit (b : ℕ) (hb : b < 147) (o : ℕ) (gates : List Gate)
    (hg : ∀ g ∈ gates, isAO g.op = true) (S : ℕ) (wl : List Bool)
    (hS : ∀ i, S.testBit (147 * i + b) = wl.getD i false) (i : ℕ) :
    (run gates wl.length S).testBit (147 * i + b)
      = (Circuit.wires ⟨gates, o⟩ wl).getD i false := by
  induction gates generalizing S wl with
  | nil => exact hS i
  | cons g t ih =>
    have h1 := ih (fun g' hg' => hg g' (List.mem_cons_of_mem _ hg')) (stp S wl.length g)
      (wl ++ [g.op.eval (g.inputs.map fun k => wl.getD k false)])
      (stp_bit b hb g (hg g List.mem_cons_self) S wl hS)
    rw [List.length_append, List.length_singleton] at h1
    exact h1

def catB : List ℕ → ℕ
  | [] => 0
  | b :: t => 2 ^ 147 * catB t + b

theorem catB_bit (l : List ℕ) (hl : ∀ v ∈ l, v < 2 ^ 147) (a b : ℕ) (hb : b < 147) :
    (catB l).testBit (147 * a + b) = (l.getD a 0).testBit b := by
  induction l generalizing a with
  | nil => simp [catB]
  | cons v t ih =>
    have hv : v < 2 ^ 147 := hl v List.mem_cons_self
    have ht : ∀ u ∈ t, u < 2 ^ 147 := fun u hu => hl u (List.mem_cons_of_mem _ hu)
    simp only [catB]
    rw [Nat.testBit_two_pow_mul_add (catB t) hv]
    cases a with
    | zero => simp [hb]
    | succ a' =>
      have h1 : ¬ (147 * (a' + 1) + b < 147) := by omega
      have h2 : 147 * (a' + 1) + b - 147 = 147 * a' + b := by omega
      rw [if_neg h1, h2, ih ht a']
      simp

def blk (a i : ℕ) : ℕ := if a = i then 2 ^ 147 - 1 else 2 ^ i

theorem blk_lt (a i : ℕ) (hi : i < 146) : blk a i < 2 ^ 147 := by
  unfold blk
  split
  · exact Nat.sub_lt (Nat.two_pow_pos _) Nat.one_pos
  · exact Nat.pow_lt_pow_right (by norm_num) (by omega)

theorem blk_bit (a i b : ℕ) (hb : b < 147) :
    (blk a i).testBit b = (decide (i = a) || decide (i = b)) := by
  unfold blk
  by_cases hai : a = i
  · rw [if_pos hai, Nat.testBit_two_pow_sub_one]
    simp [hb, hai]
  · rw [if_neg hai, Nat.testBit_two_pow]
    have : ¬ (i = a) := fun h => hai h.symm
    simp [this]

def initS (a : ℕ) : ℕ := catB ((List.range 146).map (blk a))

theorem init_bit (a b i : ℕ) (hb : b < 147) :
    (initS a).testBit (147 * i + b)
      = (decide (i < 146) && (decide (i = a) || decide (i = b))) := by
  unfold initS
  rw [catB_bit _ _ i b hb]
  · by_cases hi : i < 146
    · have h : ((List.range 146).map (blk a)).getD i 0 = blk a i := by
        simp [List.getD_eq_getElem?_getD, hi]
      rw [h, blk_bit a i b hb]
      simp [hi]
    · have h : ((List.range 146).map (blk a)).getD i 0 = 0 := by
        rw [List.getD_eq_getElem?_getD, List.getElem?_eq_none (by simp; omega)]
        rfl
      rw [h]
      simp [hi]
  · intro v hv
    rw [List.mem_map] at hv
    obtain ⟨i', hi', rfl⟩ := hv
    exact blk_lt a i' (List.mem_range.mp hi')

theorem z_getD (x y : Fin 73 → Bool) (a b : ℕ)
    (hx : ∀ p : Fin 73, x p = (decide ((p : ℕ) = a) || decide ((p : ℕ) = b)))
    (hy : ∀ l : Fin 73, y l = (decide ((l : ℕ) + 73 = a) || decide ((l : ℕ) + 73 = b)))
    (i : ℕ) :
    (List.ofFn x ++ List.ofFn y).getD i false
      = (decide (i < 146) && (decide (i = a) || decide (i = b))) := by
  rw [List.getD_eq_getElem?_getD]
  by_cases h1 : i < 73
  · have h146 : i < 146 := by omega
    rw [List.getElem?_append_left (by simpa using h1), List.getElem?_ofFn, dif_pos h1,
      Option.getD_some, hx]
    simp [h146]
  · by_cases h2 : i < 146
    · have h3 : i - 73 < 73 := by omega
      have h4 : i - 73 + 73 = i := by omega
      rw [List.getElem?_append_right (by simpa using h1), List.length_ofFn,
        List.getElem?_ofFn, dif_pos h3, Option.getD_some, hy]
      simp [h2, h4]
    · rw [List.getElem?_eq_none (by simp; omega)]
      simp [h2]

def expB (inc : List (ℕ × ℕ)) (a : ℕ) : ℕ :=
  inc.foldr (fun pl acc =>
    ((if a = pl.1 then 2 ^ (73 + pl.2) else 0) ||| (if a = 73 + pl.2 then 2 ^ pl.1 else 0))
      ||| acc) 0

theorem ite_bit (c : Prop) [Decidable c] (n b : ℕ) :
    ((if c then 2 ^ n else 0).testBit b = true) ↔ (c ∧ b = n) := by
  by_cases h : c
  · rw [if_pos h, Nat.testBit_two_pow, decide_eq_true_eq]
    constructor
    · intro h'; exact ⟨h, h'.symm⟩
    · intro h'; exact h'.2.symm
  · rw [if_neg h, Nat.zero_testBit]
    simp [h]

theorem expB_bit (inc : List (ℕ × ℕ)) (a b : ℕ) :
    (expB inc a).testBit b = true ↔
      ∃ pl ∈ inc, (a = pl.1 ∧ b = 73 + pl.2) ∨ (a = 73 + pl.2 ∧ b = pl.1) := by
  induction inc with
  | nil => simp [expB]
  | cons q t ih =>
    have e : expB (q :: t) a =
        ((if a = q.1 then 2 ^ (73 + q.2) else 0) ||| (if a = 73 + q.2 then 2 ^ q.1 else 0))
          ||| expB t a := rfl
    rw [e, Nat.testBit_lor, Nat.testBit_lor, Bool.or_eq_true, Bool.or_eq_true, ih,
      ite_bit, ite_bit]
    simp only [List.mem_cons, exists_eq_or_imp]

theorem two_rows (x y : Fin 73 → Bool)
    (h : (Finset.univ.filter (fun p : Fin 73 => x p = true)).card
      + (Finset.univ.filter (fun l : Fin 73 => y l = true)).card ≤ 2) :
    ∃ a b : ℕ, a < 147 ∧ b < 147 ∧
      (∀ p : Fin 73, x p = (decide ((p : ℕ) = a) || decide ((p : ℕ) = b))) ∧
      (∀ l : Fin 73, y l = (decide ((l : ℕ) + 73 = a) || decide ((l : ℕ) + 73 = b))) := by
  classical
  set Sx := Finset.univ.filter (fun p : Fin 73 => x p = true) with hSx
  set Sy := Finset.univ.filter (fun l : Fin 73 => y l = true) with hSy
  set T : Finset ℕ :=
    Sx.image (fun p : Fin 73 => (p : ℕ)) ∪ Sy.image (fun l : Fin 73 => (l : ℕ) + 73) with hT
  have hTc : T.card ≤ 2 := by
    refine le_trans (Finset.card_union_le _ _) ?_
    exact le_trans (Nat.add_le_add Finset.card_image_le Finset.card_image_le) h
  have hTlt : ∀ t ∈ T, t < 146 := by
    intro t ht
    rw [hT, Finset.mem_union, Finset.mem_image, Finset.mem_image] at ht
    rcases ht with ⟨p, _, rfl⟩ | ⟨l, _, rfl⟩
    · have := p.isLt; omega
    · have := l.isLt; omega
  have hxT : ∀ p : Fin 73, x p = true ↔ (p : ℕ) ∈ T := by
    intro p
    rw [hT, Finset.mem_union, Finset.mem_image, Finset.mem_image]
    constructor
    · intro hp
      exact Or.inl ⟨p, by simp [hSx, hp], rfl⟩
    · rintro (⟨p', hp', he⟩ | ⟨l, _, he⟩)
      · have e2 : p' = p := Fin.ext he
        subst e2
        simpa [hSx] using hp'
      · have := p.isLt; omega
  have hyT : ∀ l : Fin 73, y l = true ↔ (l : ℕ) + 73 ∈ T := by
    intro l
    rw [hT, Finset.mem_union, Finset.mem_image, Finset.mem_image]
    constructor
    · intro hl
      exact Or.inr ⟨l, by simp [hSy, hl], rfl⟩
    · rintro (⟨p, _, he⟩ | ⟨l', hl', he⟩)
      · have := p.isLt; omega
      · have e2 : l' = l := Fin.ext (by omega)
        subst e2
        simpa [hSy] using hl'
  have key : ∃ a b : ℕ, a < 147 ∧ b < 147 ∧ ∀ t : ℕ, t < 146 → (t ∈ T ↔ (t = a ∨ t = b)) := by
    have hc : T.card = 0 ∨ T.card = 1 ∨ T.card = 2 := by omega
    rcases hc with h0 | h1 | h2
    · rw [Finset.card_eq_zero] at h0
      refine ⟨146, 146, by norm_num, by norm_num, ?_⟩
      intro t ht
      rw [h0]
      constructor
      · intro h'; simp at h'
      · intro h'; omega
    · rw [Finset.card_eq_one] at h1
      obtain ⟨a, ha⟩ := h1
      have h3 : a < 146 := hTlt a (by rw [ha]; simp)
      refine ⟨a, a, by omega, by omega, ?_⟩
      intro t _; rw [ha]; simp
    · rw [Finset.card_eq_two] at h2
      obtain ⟨a, b, _, hab⟩ := h2
      have h3 : a < 146 := hTlt a (by rw [hab]; simp)
      have h4 : b < 146 := hTlt b (by rw [hab]; simp)
      refine ⟨a, b, by omega, by omega, ?_⟩
      intro t _; rw [hab]; simp
  obtain ⟨a, b, ha, hb, hk⟩ := key
  refine ⟨a, b, ha, hb, ?_, ?_⟩
  · intro p
    rw [Bool.eq_iff_iff, hxT p, hk _ (by have := p.isLt; omega)]
    simp
  · intro l
    rw [Bool.eq_iff_iff, hyT l, hk _ (by have := l.isLt; omega)]
    simp

