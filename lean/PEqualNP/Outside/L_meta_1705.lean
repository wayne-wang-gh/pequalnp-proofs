-- At most two inputs on: the on set is empty, a single input or a pair.
private lemma two_on {n : ℕ} (z : Fin n → Bool)
    (hc : (Finset.univ.filter (fun a : Fin n => z a = true)).card ≤ 2) :
    ∃ i j : ℕ, i ≤ n ∧ j ≤ n ∧ ∀ a : Fin n, z a = true ↔ (a.val = i ∨ a.val = j) := by
  have hmem : ∀ (S : Finset (Fin n)), S = Finset.univ.filter (fun a : Fin n => z a = true) →
      ∀ a : Fin n, a ∈ S ↔ z a = true := by
    intro S hS a
    rw [hS]
    simp
  have hcases : ∀ m : ℕ, m ≤ 2 → m = 0 ∨ m = 1 ∨ m = 2 := by
    intro m hm
    omega
  rcases hcases _ hc with h0 | h1 | h2
  · have hm := hmem _ (Finset.card_eq_zero.mp h0).symm
    refine ⟨n, n, le_refl n, le_refl n, fun a => ?_⟩
    constructor
    · intro h
      exact absurd ((hm a).mpr h) (by simp)
    · intro h
      rcases h with h | h <;> exact absurd h (Nat.ne_of_lt a.isLt)
  · obtain ⟨b, hb⟩ := Finset.card_eq_one.mp h1
    have hm := hmem _ hb.symm
    refine ⟨b.val, b.val, Nat.le_of_lt b.isLt, Nat.le_of_lt b.isLt, fun a => ?_⟩
    rw [← hm a, Finset.mem_singleton, Fin.ext_iff, or_self]
  · obtain ⟨b, c, _, hbc⟩ := Finset.card_eq_two.mp h2
    have hm := hmem _ hbc.symm
    refine ⟨b.val, c.val, Nat.le_of_lt b.isLt, Nat.le_of_lt c.isLt, fun a => ?_⟩
    rw [← hm a, Finset.mem_insert, Finset.mem_singleton, Fin.ext_iff, Fin.ext_iff]

