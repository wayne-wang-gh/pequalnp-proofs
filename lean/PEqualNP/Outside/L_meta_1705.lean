import Mathlib
import PEqualNP.Defs

namespace PEqualNP.Outside.L_meta_1705

open PEqualNP.CircuitLowerBounds

private def step (w : List Bool) (g : Gate) : List Bool :=
  w ++ [g.op.eval (g.inputs.map fun i => w.getD i false)]

private lemma step_len (w : List Bool) (g : Gate) : (step w g).length = w.length + 1 := by
  simp [step]

private lemma step_lt (w : List Bool) (g : Gate) (i : ℕ) (hi : i < w.length) :
    (step w g).getD i false = w.getD i false := by
  simp [step, List.getD, List.getElem?_append_left hi]

private lemma step_last (w : List Bool) (g : Gate) (k : ℕ) (hk : k = w.length) :
    (step w g).getD k false = g.op.eval (g.inputs.map fun i => w.getD i false) := by
  subst hk
  simp [step, List.getD]

private lemma eval_fold (gs : List Gate) (o : ℕ) (u : List Bool) :
    Circuit.eval ⟨gs, o⟩ u = (gs.foldl step u).getD o false := rfl

private lemma ev_and2 (u v : Bool) : GateOp.eval GateOp.and [u, v] = (u && v) := by
  cases u <;> cases v <;> rfl

private lemma ev_or2 (u v : Bool) : GateOp.eval GateOp.or [u, v] = (u || v) := by
  cases u <;> cases v <;> rfl

private lemma and_l {a b : Bool} (h : (a && b) = true) : a = true := by
  revert h
  cases a <;> cases b <;> decide

private lemma and_r {a b : Bool} (h : (a && b) = true) : b = true := by
  revert h
  cases a <;> cases b <;> decide

-- Certified tables: W lists one natural number per wire, bit k of it being the value of
-- the wire on input number k. gchk checks one gate against the list.
private def gchk (W : List ℕ) (n : ℕ) (g : Gate) : Bool :=
  match g.op, g.inputs with
  | GateOp.and, [a, b] => decide (a < n) && (decide (b < n) &&
      decide (W.getD n 0 = Nat.land (W.getD a 0) (W.getD b 0)))
  | GateOp.or, [a, b] => decide (a < n) && (decide (b < n) &&
      decide (W.getD n 0 = Nat.lor (W.getD a 0) (W.getD b 0)))
  | _, _ => false

private def chk (W : List ℕ) : ℕ → List Gate → Bool
  | _, [] => true
  | n, g :: gs => gchk W n g && chk W (n + 1) gs

private lemma chk_cons (W : List ℕ) (n : ℕ) (g : Gate) (gs : List Gate) :
    chk W n (g :: gs) = (gchk W n g && chk W (n + 1) gs) := rfl

private lemma gand (W : List ℕ) (k : ℕ) (u : List Bool) (a b : ℕ)
    (hu : ∀ t, t < u.length → u.getD t false = (W.getD t 0).testBit k)
    (hg : (decide (a < u.length) && (decide (b < u.length) &&
      decide (W.getD u.length 0 = Nat.land (W.getD a 0) (W.getD b 0)))) = true) :
    GateOp.eval GateOp.and ([a, b].map fun i => u.getD i false) =
      (W.getD u.length 0).testBit k := by
  have ha : a < u.length := of_decide_eq_true (and_l hg)
  have hb : b < u.length := of_decide_eq_true (and_l (and_r hg))
  have hw : W.getD u.length 0 = Nat.land (W.getD a 0) (W.getD b 0) :=
    of_decide_eq_true (and_r (and_r hg))
  rw [hw]
  show GateOp.eval GateOp.and [u.getD a false, u.getD b false] =
    Nat.testBit (W.getD a 0 &&& W.getD b 0) k
  rw [ev_and2, Nat.testBit_and, hu a ha, hu b hb]

private lemma gor (W : List ℕ) (k : ℕ) (u : List Bool) (a b : ℕ)
    (hu : ∀ t, t < u.length → u.getD t false = (W.getD t 0).testBit k)
    (hg : (decide (a < u.length) && (decide (b < u.length) &&
      decide (W.getD u.length 0 = Nat.lor (W.getD a 0) (W.getD b 0)))) = true) :
    GateOp.eval GateOp.or ([a, b].map fun i => u.getD i false) =
      (W.getD u.length 0).testBit k := by
  have ha : a < u.length := of_decide_eq_true (and_l hg)
  have hb : b < u.length := of_decide_eq_true (and_l (and_r hg))
  have hw : W.getD u.length 0 = Nat.lor (W.getD a 0) (W.getD b 0) :=
    of_decide_eq_true (and_r (and_r hg))
  rw [hw]
  show GateOp.eval GateOp.or [u.getD a false, u.getD b false] =
    Nat.testBit (W.getD a 0 ||| W.getD b 0) k
  rw [ev_or2, Nat.testBit_or, hu a ha, hu b hb]

private lemma gchk_sound (W : List ℕ) (k : ℕ) (u : List Bool) (g : Gate)
    (hu : ∀ t, t < u.length → u.getD t false = (W.getD t 0).testBit k)
    (hg : gchk W u.length g = true) :
    g.op.eval (g.inputs.map fun i => u.getD i false) = (W.getD u.length 0).testBit k := by
  rcases g with ⟨op, inputs⟩
  rcases inputs with _ | ⟨a, _ | ⟨b, _ | ⟨c, r⟩⟩⟩ <;> cases op <;>
    first
    | exact Bool.noConfusion (show false = true from hg)
    | exact gand W k u a b hu hg
    | exact gor W k u a b hu hg

private lemma sound (W : List ℕ) (k : ℕ) (gs : List Gate) :
    ∀ u : List Bool, (∀ t, t < u.length → u.getD t false = (W.getD t 0).testBit k) →
      chk W u.length gs = true →
      ∀ t, t < u.length + gs.length →
        (gs.foldl step u).getD t false = (W.getD t 0).testBit k := by
  induction gs with
  | nil =>
    intro u hu _ t ht
    exact hu t (by simpa using ht)
  | cons g gs ih =>
    intro u hu hc t ht
    rw [chk_cons] at hc
    have hc1 : gchk W u.length g = true := and_l hc
    have hc2 : chk W (u.length + 1) gs = true := and_r hc
    rw [List.foldl_cons]
    refine ih (step u g) (fun s hs => ?_) (by rw [step_len]; exact hc2) t
      (by rw [step_len]; simp only [List.length_cons] at ht; omega)
    by_cases hlt : s < u.length
    · rw [step_lt u g s hlt]
      exact hu s hlt
    · have heq : s = u.length := by
        rw [step_len] at hs
        omega
      subst heq
      rw [step_last u g u.length rfl]
      exact gchk_sound W k u g hu hc1

