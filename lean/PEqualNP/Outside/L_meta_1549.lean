lemma thetaF_graph_edges (x : Fin 10 → Bool) : thetaF x = true ↔
    ∃ u v : Fin 10, thetaGraphConcrete.Adj u v ∧ x u = true ∧ x v = true := by
  change ThetaGraphFacts.edgeFun ThetaGraphFacts.edges x = true ↔ _
  rw [ThetaGraphFacts.edgeFun_true]
  constructor
  · rintro ⟨a, b, edge, ha, hb⟩
    exact ⟨a, b, Or.inl edge, ha, hb⟩
  · rintro ⟨a, b, adjacent, ha, hb⟩
    change (a, b) ∈ ThetaGraphFacts.edges ∨ (b, a) ∈ ThetaGraphFacts.edges at adjacent
    rcases adjacent with edge | edge
    · exact ⟨a, b, edge, ha, hb⟩
    · exact ⟨b, a, edge, hb, ha⟩

lemma least_theta_output_valid {gs : List Gate} {out : Nat} (least : Least 10 thetaF gs out) :
    out < 10 + gs.length := by
  by_contra! after
  obtain ⟨x, y, different⟩ := least.ncv theta_nonconstant
  exact different ((vl_beyond gs x out after).trans (vl_beyond gs y out after).symm)

theorem least_theta_five_branches (gs : List Gate) (out : Nat) (least : Least 10 thetaF gs out)
    (_gateLimit : gs.length ≤ 14) : 5 ≤ (circuitBranchWires (n := 10) gs).card := by
  classical
  letI : DecidableRel thetaGraphConcrete.Adj := thetaGraphDecidable
  have outValid := least_theta_output_valid least
  let outWire : Fin (10 + gs.length) := ⟨out, outValid⟩
  have live := least_read_edge_live least theta_nonconstant theta_depends theta_restrict_nonconstant outValid
  let label : Fin 10 → Fin (10 + gs.length) := firstInputBoundary least.hcl outWire live
  let branches : Finset (Fin (10 + gs.length)) := circuitBranchWires gs
  have computes (x : Fin 10 → Bool) : vl gs x outWire.val = PetersenScratch.edgeValue thetaGraphConcrete x := by
    change vl gs x out = _
    rw [least.hev, Bool.eq_iff_iff, thetaF_graph_edges]
    simp only [PetersenScratch.edgeValue, decide_eq_true_eq]
  have marked (S : Finset (Fin 10)) : vl gs (setInput S) outWire.val = true ↔
      BranchGraph.containsEdge thetaGraphConcrete S := by
    change vl gs (setInput S) out = true ↔ _
    rw [least.hev]
    exact theta_graph_marked_edges S
  have independent (r) : BranchGraph.Independent thetaGraphConcrete (BranchGroupsLean.bucket label r) :=
    firstInputGroup_independent least.hcl outWire live (predecessors_nodup least theta_nonconstant)
      thetaGraphConcrete computes theta_graph_alternate_neighbors r
  have labels (v : Fin 10) : label v = outWire ∨ label v ∈ branches := by
    have stopped := FirstBranchRoute.first_stops (readEdge gs) outWire (read_order least.hcl) live (inputWire gs v)
    rcases stopped with outLabel | fork
    · exact Or.inl outLabel
    · exact Or.inr (in_circuit_branches.mpr fork)
  have before (r) (member : r ∈ branches) : r < outWire := by
    obtain ⟨a, _, path, _, _⟩ := in_circuit_branches.mp member
    exact lt_of_lt_of_le (read_order least.hcl path) (wire_le_output least.hcl outWire live a)
  have twins (r) (member : r ∈ branches) : BranchGraph.TwinGroup thetaGraphConcrete
      (BranchGroupsLean.below label r) (BranchGroupsLean.bucket label r) :=
    circuit_branch_class_twins least.hcl outWire live thetaGraphConcrete marked r
      (le_of_lt (before r member)) (Or.inr (in_circuit_branches.mp member)) (independent r)
  exact BranchGroupsLean.roots_required thetaGraphConcrete label outWire branches 5 labels before twins
    (independent outWire) (PetersenMaskBridge.theta_groups_need_five thetaGraphConcrete theta_graph_matches_mask)

end PEqualNP.Outside.L_meta_1549_aux

open PEqualNP.Outside.L_meta_1549_aux

theorem PEqualNP.Outside.L_meta_1549 : ∀ s : ℕ, PEqualNP.MetaComplexity.HasCircuitSize 10 (fun x : Fin 10 → Bool => ([(0, 2), (2, 3), (3, 1), (0, 4), (4, 5), (5, 6), (6, 1), (0, 7), (7, 8), (8, 9), (9, 1)] : List (Fin 10 × Fin 10)).any (fun e => x e.1 && x e.2)) s → 15 ≤ s :=
  PEqualNP.Outside.L_meta_1549_aux.theta_gate_lower_of_branch_bound
    PEqualNP.Outside.L_meta_1549_aux.least_theta_five_branches
