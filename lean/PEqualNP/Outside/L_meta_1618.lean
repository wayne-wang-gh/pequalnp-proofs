    ((PI ∧ R ∧ (∃ jc, ca jc ∧ cb jc) ∧ ∀ jk, ca jk → cb jk → Xa jk ∧ Xb jk ∧
        ∃ jt, ca jt ∧ cb jt ∧ ∃ ut, ¬ Ip ut ∧ (Sa jt ut ∨ Sb jt ut)) ∨
     (PI ∧ R ∧ (∃ jc, ca jc ∧ cb jc) ∧ ∀ jk, ca jk → cb jk → Xa jk ∧ Xb jk ∧
        (∀ jm, ca jm → cb jm → ∀ um, (Sa jm um ∨ Sb jm um) → Ip um) ∧
        ∃ jt, ca jt ∧ cb jt ∧ ∃ ut, (Sa jt ut ∨ Sb jt ut))) ∨
     (PI ∧ R ∧ (∃ jc, ca jc ∧ cb jc) ∧ ∀ jk, ca jk → cb jk → Xa jk ∧ Xb jk ∧
        ∀ jm, ca jm → cb jm → ∀ um, ¬ Sa jm um ∧ ¬ Sb jm um) := by
  obtain ⟨hI, hr, hex, hall⟩ := h
  by_cases P1 : ∃ jt, ca jt ∧ cb jt ∧ ∃ ut, ¬ Ip ut ∧ (Sa jt ut ∨ Sb jt ut)
  · left; left
    exact ⟨hI, hr, hex, fun jk a b => ⟨(hall jk a b).1, (hall jk a b).2, P1⟩⟩
  · by_cases P2 : ∃ jt, ca jt ∧ cb jt ∧ ∃ ut, (Sa jt ut ∨ Sb jt ut)
    · left; right
      refine ⟨hI, hr, hex, fun jk a b => ⟨(hall jk a b).1, (hall jk a b).2, ?_, P2⟩⟩
      intro jm a' b' um hs
      by_contra hn
      exact P1 ⟨jm, a', b', um, hn, hs⟩
    · right
      exact ⟨hI, hr, hex, fun jk a b => ⟨(hall jk a b).1, (hall jk a b).2,
        fun jm a' b' um => ⟨fun hs => P2 ⟨jm, a', b', um, Or.inl hs⟩,
          fun hs => P2 ⟨jm, a', b', um, Or.inr hs⟩⟩⟩⟩

theorem cnt {α : Type} [DecidableEq α] (A B C D : Finset α) (s J N : ℕ)
    (hs : D ⊆ (A ∪ B) ∪ C) (hA : A.card ≤ 192 * (s + (J + J)) + 8 * N)
    (hB : B.card ≤ 104 * s + 8 * J + 4 * N) (hC : C.card ≤ 104 * s + 8 * J + 4 * N) :
    D.card ≤ 400 * (s + J) + 16 * N := by
  have h1 := Finset.card_le_card hs
  have h2 := Finset.card_union_le (A ∪ B) C
  have h3 := Finset.card_union_le A B
  omega

