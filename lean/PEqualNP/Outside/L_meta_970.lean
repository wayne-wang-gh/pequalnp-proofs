                  have h0 := hs_zero_other uk v (G.ne_of_adj hvuk)
                  rw [h0] at h1; exact absurd h1 (by decide)
                have hsu_eq := ihw (orEnd uk.val) (by omega) (by omega) hsu_not_Tv
                have hsu_x0 : (C.wires (List.ofFn x0)).getD (orEnd uk.val) false = false :=
                  hs_zero_other uk v' hv'uk
                have hsu_x1 : (C.wires (List.ofFn x1)).getD (orEnd uk.val) false = false :=
                  hsu_eq.symm.trans hsu_x0
                have hg : C.gates[j]? = some (C.gates[j]'hjlt) := List.getElem?_eq_getElem hjlt
                have hgop : (C.gates[j]'hjlt).op = GateOp.and := by
                  simpa only [hjeq] using handuk
                have hmem_su' : orEnd uk.val ∈ (C.gates[j]'hjlt).inputs := by
                  simpa only [hjeq] using hmem_su
                have hf_and : ∀ y : Fin n → Bool, (C.wires (List.ofFn y)).getD (orEnd uk.val) false = false →
                    (C.wires (List.ofFn y)).getD w false = false := by
                  intro y hy0
                  rw [hwj, wires_gate_ofFn C y j _ hg, hgop]
                  change ((C.gates[j]'hjlt).inputs.map fun i => if i < n + j then (C.wires (List.ofFn y)).getD i false else false).all id = false
                  cases hv_all : ((C.gates[j]'hjlt).inputs.map fun i => if i < n + j then (C.wires (List.ofFn y)).getD i false else false).all id with
                  | false => rfl
                  | true =>
                    have ht := List.all_eq_true.mp hv_all _ (List.mem_map_of_mem hmem_su')
                    simp only [id_eq, hsu_lt, ↓reduceIte, hy0] at ht
                    exact absurd ht (by decide)
                exact (hf_and x0 hsu_x0).trans (hf_and x1 hsu_x1).symm
              rcases hjEv with h1 | h2
              · exact hand_zero u1 hu1_in hv'ne1 (congrArg Fin.val h1)
              · exact hand_zero u2 hu2_in hv'ne2 (congrArg Fin.val h2)
            · have hg : C.gates[j]? = some (C.gates[j]'hjlt) := List.getElem?_eq_getElem hjlt
              rw [hwj, wires_gate_ofFn C x0 j _ hg, wires_gate_ofFn C x1 j _ hg]
              congr 1
              apply List.map_congr_left
              intro i hi
              by_cases hilt : i < n + j
              · simp only [hilt, ↓reduceIte]
                have hiNot : i ∉ Tv := fun hiTv => hjEv ((hmem_Ev ⟨j, hjlt⟩).mpr ⟨hwj ▸ hwNot, i, hi, hiTv⟩)
                exact ihw i (by omega) (by omega) hiNot
              · simp only [hilt, ↓reduceIte]
      have heval := hnot_Tv_eq C.output (by omega) (hout_last ▸ hout_not_Tv)
      change C.eval (List.ofFn x0) = C.eval (List.ofFn x1) at heval
      have hf0 : C.eval (List.ofFn x0) = false := by
        cases h : C.eval (List.ofFn x0) with
        | false => rfl
        | true =>
          obtain ⟨a, b, hab, ha, hb⟩ := (hfun x0).mp h
          simp only [x0, decide_eq_true_eq] at ha hb
          subst ha; subst hb; exact absurd hab (G.loopless.irrefl _)
      have hf1 : C.eval (List.ofFn x1) = true := by
        rw [hfun]
        exact ⟨v, v', hvv', by simp [x1], by simp [x1, x0, hvv'_ne.symm]⟩
      rw [hf0, hf1] at heval; exact absurd heval (by decide)
    have hdouble_count : 3 * I.card ≤ Tbranch.card := by
      have h1 : ∑ u ∈ I, (G.neighborFinset u ∩ Tbranch).card = ∑ v ∈ Tbranch, (G.neighborFinset v ∩ I).card := by
        have hLHS : ∑ u ∈ I, (G.neighborFinset u ∩ Tbranch).card =
            ∑ u ∈ I, ∑ v ∈ Tbranch, if G.Adj u v then 1 else 0 := by
          apply Finset.sum_congr rfl
          intro u _
          rw [Finset.sum_boole]
          congr 1
          ext v
          simp [SimpleGraph.mem_neighborFinset, and_comm]
        have hRHS : ∑ v ∈ Tbranch, (G.neighborFinset v ∩ I).card =
            ∑ v ∈ Tbranch, ∑ u ∈ I, if G.Adj u v then 1 else 0 := by
          apply Finset.sum_congr rfl
          intro v _
          rw [Finset.sum_boole]
          congr 1
          ext u
          simp [SimpleGraph.mem_neighborFinset, SimpleGraph.adj_comm, and_comm]
        rw [hLHS, hRHS, Finset.sum_comm]
      have hLHS_eq : ∑ u ∈ I, (G.neighborFinset u ∩ Tbranch).card = 3 * I.card := by
        trans ∑ _u ∈ I, 3
        · apply Finset.sum_congr rfl
          intro u hu
          have hsub : G.neighborFinset u ⊆ Tbranch := by
            intro v hv
            have huv : G.Adj u v := (SimpleGraph.mem_neighborFinset G u v).mp hv
            rcases hvc u v huv with huT | hvT
            · exact absurd huT (Finset.mem_sdiff.mp hu).2
            · exact hvT
          rw [Finset.inter_eq_left.mpr hsub, ← SimpleGraph.degree, hdeg3 u]
        · simp [mul_comm]
      have hRHS_le : ∑ v ∈ Tbranch, (G.neighborFinset v ∩ I).card ≤ Tbranch.card := by
        have := Finset.sum_le_sum hT_nbr_I
        simpa using this
      omega
    omega

end PEqualNP.Outside.L_meta_970

namespace PEqualNP.Outside.L_meta_970_aux

def edges : List (ℕ × ℕ) := [(0, 1), (0, 2), (0, 4), (1, 3), (1, 5), (2, 3), (2, 6), (3, 7), (4, 5), (4, 6), (5, 7), (6, 7)]

def rel (u v : Fin 8) : Bool := decide ((u.val,v.val) ∈ edges ∨ (v.val,u.val) ∈ edges)

def graph : SimpleGraph (Fin 8) where
  Adj u v := rel u v = true
  symm := ⟨by decide⟩
  loopless := ⟨by decide⟩

theorem cubic (v : Fin 8) : (graph.neighborSet v).ncard = 3 := by
  have he : graph.neighborSet v = ((Finset.univ.filter (fun w : Fin 8 => rel v w = true) : Finset (Fin 8)) : Set (Fin 8)) := by
    ext u
    simp [SimpleGraph.mem_neighborSet, graph]
  rw [he, Set.ncard_coe_finset]
  exact (by decide : ∀ w : Fin 8, (Finset.univ.filter (fun z : Fin 8 => rel w z = true)).card = 3) v

theorem distinctRel : ∀ v w : Fin 8, v ≠ w → ∃ u : Fin 8, rel v u = true ∧ ¬ rel w u = true := by
  decide

theorem distinct (v w : Fin 8) (h : v ≠ w) : ∃ u : Fin 8, graph.Adj v u ∧ ¬ graph.Adj w u :=
  distinctRel v w h

theorem indepRel : ∀ u ∈ ({0, 3, 5, 6} : Finset (Fin 8)), ∀ v ∈ ({0, 3, 5, 6} : Finset (Fin 8)),
    ¬ rel u v = true := by
  decide

theorem indep : ∃ J : Finset (Fin 8), (∀ u ∈ J, ∀ v ∈ J, ¬ graph.Adj u v) ∧ 8 + 1 ≤ 4 * J.card :=
  ⟨{0, 3, 5, 6}, indepRel, by decide⟩

theorem coverRel : ∀ u v : Fin 8, rel u v = true →
    u ∈ ({1, 2, 4, 7} : Finset (Fin 8)) ∨ v ∈ ({1, 2, 4, 7} : Finset (Fin 8)) := by
  decide

theorem exampleCover : ∃ S : Finset (Fin 8),
    PEqualNP.MetaComplexity.CoverPromise.IsVertexCover graph S ∧ S.card = 4 :=
  ⟨{1, 2, 4, 7}, fun u v h => coverRel u v h, by decide⟩

theorem minCover : ∀ S : Finset (Fin 8),
    PEqualNP.MetaComplexity.CoverPromise.IsVertexCover graph S → 4 ≤ S.card := by
  intro S hS
  have hS' : ∀ u v : Fin 8, rel u v = true → u ∈ S ∨ v ∈ S := fun u v h => hS u v h
  obtain ⟨a, ha, ha'⟩ : ∃ a ∈ S, a = (0 : Fin 8) ∨ a = 1 := by
    rcases hS' 0 1 (by decide) with h | h
    · exact ⟨0, h, Or.inl rfl⟩
    · exact ⟨1, h, Or.inr rfl⟩
  obtain ⟨b, hb, hb'⟩ : ∃ b ∈ S, b = (2 : Fin 8) ∨ b = 3 := by
    rcases hS' 2 3 (by decide) with h | h
    · exact ⟨2, h, Or.inl rfl⟩
    · exact ⟨3, h, Or.inr rfl⟩
  obtain ⟨c, hc, hc'⟩ : ∃ c ∈ S, c = (4 : Fin 8) ∨ c = 5 := by
    rcases hS' 4 5 (by decide) with h | h
    · exact ⟨4, h, Or.inl rfl⟩
    · exact ⟨5, h, Or.inr rfl⟩
  obtain ⟨d, hd, hd'⟩ : ∃ d ∈ S, d = (6 : Fin 8) ∨ d = 7 := by
    rcases hS' 6 7 (by decide) with h | h
    · exact ⟨6, h, Or.inl rfl⟩
    · exact ⟨7, h, Or.inr rfl⟩
  have hsub : ({a, b, c, d} : Finset (Fin 8)) ⊆ S := by
    intro x hx
    simp only [Finset.mem_insert, Finset.mem_singleton] at hx
    rcases hx with rfl | rfl | rfl | rfl <;> assumption
  have hcard : ({a, b, c, d} : Finset (Fin 8)).card = 4 := by
    rcases ha' with rfl | rfl <;> rcases hb' with rfl | rfl <;>
      rcases hc' with rfl | rfl <;> rcases hd' with rfl | rfl <;> decide
  exact hcard ▸ Finset.card_le_card hsub

theorem edgeEq (x : Fin 8 → Bool) :
    (∃ u v : Fin 8, (u.val, v.val) ∈ edges ∧ x u = true ∧ x v = true) ↔
    ∃ u v : Fin 8, graph.Adj u v ∧ x u = true ∧ x v = true := by
  change _ ↔ ∃ u v, rel u v = true ∧ x u = true ∧ x v = true
  simp only [rel, decide_eq_true_eq]
  constructor
  · rintro ⟨u,v,h,hu,hv⟩
    exact ⟨u,v,Or.inl h,hu,hv⟩
  · rintro ⟨u,v,h|h,hu,hv⟩
    · exact ⟨u,v,h,hu,hv⟩
    · exact ⟨v,u,h,hv,hu⟩

end PEqualNP.Outside.L_meta_970_aux

theorem PEqualNP.Outside.L_meta_970 : ∀ C : PEqualNP.CircuitLowerBounds.Circuit, PEqualNP.MetaComplexity.Monotone2 C → (∀ x : Fin 8 → Bool, (C.eval (List.ofFn x) = true ↔ ∃ u v : Fin 8, (u.val, v.val) ∈ ([(0, 1), (0, 2), (0, 4), (1, 3), (1, 5), (2, 3), (2, 6), (3, 7), (4, 5), (4, 6), (5, 7), (6, 7)] : List (ℕ × ℕ)) ∧ x u = true ∧ x v = true)) → 12 ≤ C.size := by
  classical
  intro C hm he
  have h := PEqualNP.Outside.L_meta_970.main_bound 8 4 PEqualNP.Outside.L_meta_970_aux.graph
    PEqualNP.Outside.L_meta_970_aux.cubic PEqualNP.Outside.L_meta_970_aux.distinct
    PEqualNP.Outside.L_meta_970_aux.indep PEqualNP.Outside.L_meta_970_aux.exampleCover
    PEqualNP.Outside.L_meta_970_aux.minCover C.size C rfl hm
    (fun x => (he x).trans (PEqualNP.Outside.L_meta_970_aux.edgeEq x))
  omega
