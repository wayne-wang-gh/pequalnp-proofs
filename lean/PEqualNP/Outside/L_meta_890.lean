private def Dset : Finset (Fin 73) := {0, 1, 3, 7, 15, 31, 36, 54, 63}

private def Dlist : List (Fin 73) := [0, 1, 3, 7, 15, 31, 36, 54, 63]

private def Fam (w : Fin 73) : Finset (Fin 73) :=
  Dset.image (fun u => u + w)

private lemma Dset_card : Dset.card = 9 := by decide +kernel

private lemma mem_Dset_iff (x : Fin 73) : x ∈ Dset ↔ x ∈ Dlist := by
  simp [Dset, Dlist]

private def tblU : Fin 73 → Fin 73 := ![0, 1, 3, 3, 7, 36, 7, 7, 15, 63, 0, 1, 15, 3, 15, 15, 31, 7, 54, 0, 1, 36, 3, 54, 31, 15, 7, 63, 31, 36, 31, 31, 63, 36, 15, 36, 36, 0, 1, 54, 3, 31, 0, 1, 7, 3, 36, 54, 63, 7, 31, 54, 15, 54, 54, 36, 63, 15, 0, 1, 63, 3, 63, 63, 54, 7, 0, 1, 31, 3, 0, 1, 0]
private def tblV : Fin 73 → Fin 73 := ![0, 0, 1, 0, 3, 31, 1, 0, 7, 54, 63, 63, 3, 63, 1, 0, 15, 63, 36, 54, 54, 15, 54, 31, 7, 63, 54, 36, 3, 7, 1, 0, 31, 3, 54, 1, 0, 36, 36, 15, 36, 63, 31, 31, 36, 31, 63, 7, 15, 31, 54, 3, 36, 1, 0, 54, 7, 31, 15, 15, 3, 15, 1, 0, 63, 15, 7, 7, 36, 7, 3, 3, 1]

private lemma tbl_spec : ∀ d : Fin 73, d ≠ 0 →
    tblU d ∈ Dlist ∧ tblV d ∈ Dlist ∧ tblU d - tblV d = d := by
  decide +kernel

private lemma diff_inj : ∀ u1 ∈ Dlist, ∀ v1 ∈ Dlist, ∀ u2 ∈ Dlist, ∀ v2 ∈ Dlist,
    u1 - v1 = u2 - v2 → u1 ≠ v1 → u1 = u2 ∧ v1 = v2 := by
  decide +kernel

private lemma fam_card (i : Fin 73) : (Fam i).card = 8 + 1 := by
  unfold Fam
  rw [Finset.card_image_of_injective _ (fun a b h => add_right_cancel h)]
  exact Dset_card

private lemma fam_inter (i j : Fin 73) (hij : i ≠ j) : (Fam i ∩ Fam j).card ≤ 1 := by
  apply Finset.card_le_one.mpr
  intro x hx y hy
  rcases Finset.mem_inter.mp hx with ⟨hxi, hxj⟩
  rcases Finset.mem_inter.mp hy with ⟨hyi, hyj⟩
  rcases Finset.mem_image.mp hxi with ⟨ux, hux, rfl⟩
  rcases Finset.mem_image.mp hxj with ⟨vx, hvx, hvxeq⟩
  rcases Finset.mem_image.mp hyi with ⟨uy, huy, rfl⟩
  rcases Finset.mem_image.mp hyj with ⟨vy, hvy, hvyeq⟩
  have h1 : ux - vx = j - i := by
    have h0 : ux + i = vx + j := hvxeq.symm
    calc ux - vx = (ux + i) - (vx + i) := by abel
      _ = (vx + j) - (vx + i) := by rw [h0]
      _ = j - i := by abel
  have h2 : uy - vy = j - i := by
    have h0 : uy + i = vy + j := hvyeq.symm
    calc uy - vy = (uy + i) - (vy + i) := by abel
      _ = (vy + j) - (vy + i) := by rw [h0]
      _ = j - i := by abel
  have hne : ux ≠ vx := by
    intro heq
    have : j - i = 0 := by rw [← h1, heq, sub_self]
    exact hij (sub_eq_zero.mp this).symm
  have huxuy := (diff_inj ux ((mem_Dset_iff _).mp hux) vx ((mem_Dset_iff _).mp hvx)
    uy ((mem_Dset_iff _).mp huy) vy ((mem_Dset_iff _).mp hvy) (h1.trans h2.symm) hne).1
  rw [huxuy]

private lemma fam_pair (p1 p2 : Fin 73) (hp : p1 ≠ p2) :
    ∃ i : Fin 73, p1 ∈ Fam i ∧ p2 ∈ Fam i := by
  have hd : p1 - p2 ≠ 0 := sub_ne_zero.mpr hp
  obtain ⟨hu, hv, huv⟩ := tbl_spec (p1 - p2) hd
  refine ⟨p1 - tblU (p1 - p2), ?_, ?_⟩
  · exact Finset.mem_image.mpr ⟨tblU (p1 - p2), (mem_Dset_iff _).mpr hu, by abel⟩
  · refine Finset.mem_image.mpr ⟨tblV (p1 - p2), (mem_Dset_iff _).mpr hv, ?_⟩
    calc tblV (p1 - p2) + (p1 - tblU (p1 - p2)) = p1 - (tblU (p1 - p2) - tblV (p1 - p2)) := by abel
      _ = p1 - (p1 - p2) := by rw [huv]
      _ = p2 := by abel

private lemma fam_deg (p : Fin 73) :
    (Finset.univ.filter (fun i : Fin 73 => p ∈ Fam i)).card = 8 + 1 := by
  have heq : Finset.univ.filter (fun i : Fin 73 => p ∈ Fam i) =
      Dset.image (fun u => p - u) := by
    ext i
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, Fam, Finset.mem_image]
    constructor
    · rintro ⟨u, hu, rfl⟩
      exact ⟨u, hu, by abel⟩
    · rintro ⟨u, hu, rfl⟩
      exact ⟨u, hu, by abel⟩
  rw [heq, Finset.card_image_of_injective _ (fun a b h => by
    have : p - (p - a) = p - (p - b) := congrArg (p - ·) h
    simpa [sub_sub_cancel] using this)]
  exact Dset_card

